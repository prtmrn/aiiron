    "secondaires_par_libelles": ["groupe_musculaire", "muscles_secondaires"],
    "groupe_series_approche": "premier muscle de principaux avec compte_volume true ; aucun (exercice hors volume, ou seul principal hors volume comme core) : pas de groupe",
