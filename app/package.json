{
  "name": "aiiron-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "node --env-file-if-exists=../.env --import tsx src/chat.ts",
    "evals": "node --env-file-if-exists=../.env --import tsx src/evals/runner.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.7",
    "js-yaml": "4.3.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
